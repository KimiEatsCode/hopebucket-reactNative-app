    },
    "extra": {
      "eas": {
        "projectId": "7e1332d4-f712-43df-9957-dbef1e91fdc5"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/7e1332d4-f712-43df-9957-dbef1e91fdc5"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
